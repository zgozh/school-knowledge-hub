# ===== 存储（开发期直连 WSL Docker；交付用项目 compose 内网地址） =====
MILVUS_URI=http://localhost:19530
MONGO_URI=mongodb://localhost:27017
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=school-knowledge-hub
MINIO_SECURE=false

# ===== LLM（主备；备可留空占位） =====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus

# ===== 本地模型服务 =====
EMBED_SERVICE_URL=http://localhost:8001
RERANK_SERVICE_URL=http://localhost:8001
# 容器内固定路径（勿改）
BGE_M3_PATH=/models/bge-m3
RERANKER_PATH=/models/bge-reranker-large
# 宿主机权重目录绝对路径（compose 挂载用，请改成你的实际下载目录）
BGE_M3_LOCAL=D:/ai_models/bge-m3
RERANKER_LOCAL=D:/ai_models/bge-reranker-large

# ===== Milvus 集合 =====
MILVUS_COLLECTION=school_docs

# ===== 检索参数（ADR-006） =====
DENSE_WEIGHT=0.8
SPARSE_WEIGHT=0.2
RECALL_TOP_K=10
TIME_DECAY_HALF_LIFE_DAYS=30
EXPIRED_PENALTY=0.25
CLIFF_CUTOFF_RATIO=0.3

# ===== 服务端口 =====
COLLECTOR_PORT=8002
QA_API_PORT=8003

# ===== 通用超时 =====
EXTERNAL_TIMEOUT=10
LLM_TIMEOUT=30
